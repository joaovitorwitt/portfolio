# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the "Transaction pooler" URI (port 6543): every Vercel function instance
# opens its own connections, and the transaction pooler is built for that.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Required with the transaction pooler, which cannot hold session-level
# prepared statements. Leave unset for a direct or session-pooler connection.
USE_TRANSACTION_POOLER=1

# Pool size is per function instance, so the real ceiling is
# POOL_MAX_SIZE * live instances.
# POOL_MIN_SIZE=0
# POOL_MAX_SIZE=2

# Only used when DATABASE_URL is unset (e.g. a local postgres)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=postgres
# POSTGRES_SSLMODE=prefer

# Read-write token of the Vercel Blob store, used by scripts/migrate_images.py.
# Vercel dashboard: Storage -> the Blob store -> .env.local tab.
# BLOB_READ_WRITE_TOKEN=

# Base for absolute links (OpenGraph, RSS, sitemap, share links). On Vercel it
# defaults to the project's production domain; locally to joaovitorwitt.com.
# SITE_URL=https://www.joaovitorwitt.com

# Cache-Control for pages, in seconds.
# CACHE_MAX_AGE=300
# CACHE_STALE_WHILE_REVALIDATE=86400

PORT=8000
